// REF-NCC-FIRESTORE-DUPLICATE-BLOCK-04

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower()
           == "kpa100plus@gmail.com";
    }

    function validMemberFields() {
      return request.resource.data.keys().hasAll([
        "name",
        "phone",
        "phoneKey",
        "email",
        "birthDate",
        "gender",
        "region",
        "benefit",
        "hasPet",
        "referrer",
        "referralCode",
        "centerName",
        "centerCode",
        "agreePrivacy",
        "agreeMarketing",
        "agreeThirdParty",
        "memberNumber",
        "memberType",
        "status",
        "managementGrade",
        "adminMemo",
        "joinDate",
        "updatedAt"
      ])
      &&
      request.resource.data.keys().hasOnly([
        "name",
        "phone",
        "phoneKey",
        "email",
        "authUid",
        "birthDate",
        "gender",
        "region",
        "benefit",
        "hasPet",
        "referrer",
        "referralCode",
        "centerName",
        "centerCode",
        "centerAssignmentStatus",
        "centerAssignmentReason",
        "centerOfficialAdminCode",
        "centerLevel",
        "agreePrivacy",
        "agreeMarketing",
        "agreeThirdParty",
        "memberNumber",
        "memberType",
        "status",
        "managementGrade",
        "adminMemo",
        "joinDate",
        "updatedAt"
      ]);
    }

    function validMemberValues() {
      return
        request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50

        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 1
        && request.resource.data.phone.size() <= 30

        && request.resource.data.phoneKey is string
        && request.resource.data.phoneKey.matches('^[0-9]{9,11}$')

        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254

        && (
          !("authUid" in request.resource.data)
          || (
            request.auth != null
            && request.resource.data.authUid is string
            && request.resource.data.authUid == request.auth.uid
          )
        )

        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.size() <= 20

        && request.resource.data.gender is string
        && (
          request.resource.data.gender == ""
          || request.resource.data.gender == "male"
          || request.resource.data.gender == "female"
        )

        && request.resource.data.region is string
        && request.resource.data.region.size() >= 1
        && request.resource.data.region.size() <= 200

        && request.resource.data.benefit is string

        && request.resource.data.hasPet is string
        && (
          request.resource.data.hasPet == ""
          || request.resource.data.hasPet == "yes"
          || request.resource.data.hasPet == "no"
        )

        && request.resource.data.referrer is string
        && request.resource.data.referralCode is string

        && request.resource.data.centerName is string
        && request.resource.data.centerCode is string
        && (
          !("centerAssignmentStatus" in request.resource.data)
          || request.resource.data.centerAssignmentStatus in ["assigned", "pending"]
        )
        && (
          !("centerAssignmentReason" in request.resource.data)
          || request.resource.data.centerAssignmentReason is string
        )
        && (
          !("centerOfficialAdminCode" in request.resource.data)
          || (
            request.resource.data.centerOfficialAdminCode is string
            && (
              request.resource.data.centerOfficialAdminCode == ""
              || request.resource.data.centerOfficialAdminCode.matches('^[0-9]{10}$')
            )
          )
        )
        && (
          !("centerLevel" in request.resource.data)
          || request.resource.data.centerLevel in ["", "province", "municipality", "local"]
        )

        && request.resource.data.agreePrivacy == true
        && request.resource.data.agreeMarketing is bool
        && request.resource.data.agreeThirdParty is bool

        && request.resource.data.memberNumber is string
        && request.resource.data.memberNumber.matches(
          '^NCC-C-[0-9]{6}$'
        )

        && request.resource.data.memberType == "consumer"
        && request.resource.data.status == "active"
        && request.resource.data.managementGrade == "general"
        && request.resource.data.adminMemo == ""

        && request.resource.data.joinDate == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // ==========================================
    // MEMBERS
    // ==========================================

    match /members/{memberId} {

      allow create: if
        validMemberFields()
        && validMemberValues();

      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // PHONE UNIQUE LOCK
    // ê°ì ì íë²í¸ ì¤ë³µê°ì ë°©ì§ì©
    // ==========================================

    match /memberPhones/{phoneKey} {

      // ê°ì ê³¼ì ìì í´ë¹ ì íë²í¸ ì¡´ì¬ ì¬ë¶ íì¸
      allow get: if true;

      // ì ì²´ ì íë²í¸ ëª©ë¡ ì¡°í ê¸ì§
      allow list: if isAdmin();

      // ì ê· ì íë²í¸ë ìµì´ 1íë§ ìì±
      allow create: if
        !exists(/databases/$(database)/documents/memberPhones/$(phoneKey))
        && request.resource.data.keys().hasOnly([
          "memberId",
          "memberNumber",
          "createdAt"
        ])
        && request.resource.data.memberId is string
        && request.resource.data.memberNumber is string
        && request.resource.data.memberNumber.matches(
          '^NCC-C-[0-9]{6}$'
        )
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    // ==========================================
    // MEMBER NUMBER COUNTER
    // ==========================================

    match /counters/memberNumbers {

      allow read: if true;

      allow create: if
        isAdmin()
        && request.resource.data.keys().hasOnly([
          "consumer"
        ])
        && request.resource.data.consumer is int
        && request.resource.data.consumer >= 1;

      allow update: if
        request.resource.data.keys().hasOnly([
          "consumer"
        ])
        && request.resource.data.consumer is int
        && (
          (
            isAdmin()
            && request.resource.data.consumer
               > resource.data.consumer
          )
          ||
          (
            !isAdmin()
            && request.resource.data.consumer
               == resource.data.consumer + 1
          )
        );

      allow delete: if isAdmin();
    }
// REF-NCC-BENEFIT-APPLICATION-PRODUCTION-10

// ==========================================
// BENEFIT / SERVICE APPLICATIONS
// ííì´ì§ ííÂ·ìë¹ì¤ ì¤ì  ì ì²­ê´ë¦¬
// ==========================================

match /benefitApplications/{applicationId} {

  // Legacy anonymous application shape is permanently disabled.
  // Authenticated member creates are validated by the strict rule below.
  allow create: if
    false
    && request.resource.data.keys().hasAll([
      "type",
      "name",
      "phone",
      "region",
      "message",
      "offerId",
      "offerTitle",
      "receipt",
      "status",
      "source",
      "createdAt",
      "updatedAt"
    ])
    &&
    request.resource.data.keys().hasOnly([
      "type",
      "name",
      "phone",
      "region",
      "message",
      "offerId",
      "offerTitle",
      "receipt",
      "status",
      "source",
      "createdAt",
      "updatedAt"
    ])

    && request.resource.data.type is string
    && request.resource.data.type.size() >= 1
    && request.resource.data.type.size() <= 100

    && request.resource.data.name is string
    && request.resource.data.name.size() >= 1
    && request.resource.data.name.size() <= 50

    && request.resource.data.phone is string
    && request.resource.data.phone.size() >= 9
    && request.resource.data.phone.size() <= 30

    && request.resource.data.region is string
    && request.resource.data.region.size() >= 1
    && request.resource.data.region.size() <= 100

    && request.resource.data.message is string
    && request.resource.data.message.size() <= 1000

    && request.resource.data.offerId is string
    && request.resource.data.offerId.size() >= 1
    && request.resource.data.offerId.size() <= 100

    && request.resource.data.offerTitle is string
    && request.resource.data.offerTitle.size() >= 1
    && request.resource.data.offerTitle.size() <= 200

    && request.resource.data.receipt is string
    && request.resource.data.receipt.matches(
      '^NCC-[0-9]{6}-[0-9]{5}$'
    )

    && request.resource.data.status == "new"
    && request.resource.data.source == "website"

    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  // ì ì²­ë´ì­ ì¡°íë ê´ë¦¬ìë§ ê°ë¥
  allow read: if isAdmin();

  // ì²ë¦¬ìí ë³ê²½ë ê´ë¦¬ìë§ ê°ë¥
  allow update: if
    isAdmin()
    &&
    request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "updatedAt"
      ])
    &&
    (
      request.resource.data.status == "new"
      || request.resource.data.status == "checking"
      || request.resource.data.status == "contacted"
      || request.resource.data.status == "approved"
      || request.resource.data.status == "hold"
    )
    &&
    request.resource.data.updatedAt == request.time;

  allow delete: if isAdmin();
}

// REF-NCC-FIRESTORE-INQUIRY-PRODUCTION-01
// ìë match ë¸ë¡ì ê¸°ì¡´ Firestore ê·ì¹ì DEFAULT DENY ë°ë¡ ìì ë£ìµëë¤.

match /inquiryApplications/{applicationId} {
  allow create: if
    request.resource.data.keys().hasAll([
      "kind", "organization", "name", "phone", "region", "category",
      "message", "receipt", "status", "source", "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "kind", "organization", "name", "phone", "region", "category",
      "message", "receipt", "status", "source", "createdAt", "updatedAt"
    ])
    && (request.resource.data.kind == "partner" || request.resource.data.kind == "center")
    && request.resource.data.organization is string
    && request.resource.data.organization.size() <= 100
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 1
    && request.resource.data.name.size() <= 50
    && request.resource.data.phone is string
    && request.resource.data.phone.size() >= 9
    && request.resource.data.phone.size() <= 30
    && request.resource.data.region is string
    && request.resource.data.region.size() >= 1
    && request.resource.data.region.size() <= 100
    && request.resource.data.category is string
    && request.resource.data.category.size() >= 1
    && request.resource.data.category.size() <= 100
    && request.resource.data.message is string
    && request.resource.data.message.size() <= 1000
    && request.resource.data.receipt is string
    && request.resource.data.receipt.matches('^NCC-[PC]-[0-9]{6}-[0-9]{5}$')
    && request.resource.data.status == "new"
    && request.resource.data.source == "website"
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow read: if isAdmin();

  allow update: if
    isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
    && request.resource.data.status in ["new", "checking", "contacted", "approved", "hold"]
    && request.resource.data.updatedAt == request.time;

  allow delete: if isAdmin();
  }
  match /groupBuyProducts/{productId} {
  allow read: if isAdmin() || resource.data.published == true;

  allow create: if
    isAdmin()
    && request.resource.data.keys().hasAll([
      "title", "category", "subtitle", "description", "price", "regularPrice",
      "minParticipants", "stock", "startDate", "endDate", "status", "published",
      "image", "supplier", "shipping", "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "title", "category", "subtitle", "description", "price", "regularPrice",
      "minParticipants", "stock", "startDate", "endDate", "status", "published",
      "image", "supplier", "shipping", "createdAt", "updatedAt"
    ])
    && request.resource.data.title is string
    && request.resource.data.title.size() >= 1
    && request.resource.data.title.size() <= 120
    && request.resource.data.category is string
    && request.resource.data.category.size() >= 1
    && request.resource.data.category.size() <= 80
    && request.resource.data.subtitle is string
    && request.resource.data.subtitle.size() <= 200
    && request.resource.data.description is string
    && request.resource.data.description.size() >= 1
    && request.resource.data.description.size() <= 2000
    && request.resource.data.price is int
    && request.resource.data.price >= 0
    && request.resource.data.regularPrice is int
    && request.resource.data.regularPrice >= 0
    && request.resource.data.minParticipants is int
    && request.resource.data.minParticipants >= 1
    && request.resource.data.stock is int
    && request.resource.data.stock >= 0
    && request.resource.data.startDate is string
    && request.resource.data.endDate is string
    && request.resource.data.status in ["draft", "recruiting", "confirmed", "closed"]
    && request.resource.data.published is bool
    && request.resource.data.image is string
    && request.resource.data.image.size() <= 500
    && request.resource.data.supplier is string
    && request.resource.data.supplier.size() <= 120
    && request.resource.data.shipping is string
    && request.resource.data.shipping.size() <= 200
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow update: if
    isAdmin()
    && request.resource.data.keys().hasAll([
      "title", "category", "subtitle", "description", "price", "regularPrice",
      "minParticipants", "stock", "startDate", "endDate", "status", "published",
      "image", "supplier", "shipping", "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "title", "category", "subtitle", "description", "price", "regularPrice",
      "minParticipants", "stock", "startDate", "endDate", "status", "published",
      "image", "supplier", "shipping", "createdAt", "updatedAt"
    ])
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.updatedAt == request.time;

  allow delete: if isAdmin();
}

match /groupBuyOrders/{orderId} {
  // Legacy anonymous order shape is permanently disabled.
  // Authenticated member creates are validated by the strict rule below.
  allow create: if false;

  allow read: if isAdmin();

  allow update: if
    isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status", "paymentGuide", "carrier", "trackingNumber", "adminMemo", "updatedAt"
    ])
    && request.resource.data.status in [
      "new", "checking", "confirmed", "paid", "shipping", "completed", "cancelled"
    ]
    && request.resource.data.paymentGuide is string
    && request.resource.data.paymentGuide.size() <= 500
    && request.resource.data.carrier is string
    && request.resource.data.carrier.size() <= 60
    && request.resource.data.trackingNumber is string
    && request.resource.data.trackingNumber.size() <= 80
    && request.resource.data.adminMemo is string
    && request.resource.data.adminMemo.size() <= 500
    && request.resource.data.updatedAt == request.time;

  allow delete: if isAdmin();
}
    // ==========================================
    // DEFAULT DENY
    // ==========================================
// REF-NCC-FIRESTORE-WALLET-PRODUCTION-01
// ê¸°ì¡´ Firestore ê·ì¹ì DEFAULT DENY ë°ë¡ ìì ì¶ê°í©ëë¤.
// ê¸°ì¡´ members ê·ì¹ì ì­ì íê±°ë ìì íì§ ììµëë¤.

match /members/{memberId} {
  allow read: if
    request.auth != null
    && request.auth.token.email is string
    && request.auth.token.email_verified == true
    && (
      (
        "authUid" in resource.data
        && resource.data.authUid == request.auth.uid
      )
      || resource.data.email == request.auth.token.email
    );

  allow update: if
    ownsMember(memberId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "name", "phone", "phoneKey", "email", "region", "updatedAt"
    ])
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 1
    && request.resource.data.name.size() <= 50
    && request.resource.data.phone is string
    && request.resource.data.phone.size() >= 1
    && request.resource.data.phone.size() <= 30
    && request.resource.data.phoneKey is string
    && request.resource.data.phoneKey.matches('^[0-9]{9,11}$')
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.region is string
    && request.resource.data.region.size() >= 1
    && request.resource.data.region.size() <= 200
    && request.resource.data.updatedAt == request.time;

  allow update: if
    ownsMember(memberId)
    && resource.data.mustChangePassword == true
    && request.resource.data.mustChangePassword == false
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "mustChangePassword", "temporaryPasswordChangedAt", "updatedAt"
    ])
    && request.resource.data.temporaryPasswordChangedAt == request.time
    && request.resource.data.updatedAt == request.time;
} 
function ownsMember(memberId) {
  return request.auth != null
    && request.auth.token.email_verified == true
    && (
      (
        "authUid" in get(/databases/$(database)/documents/members/$(memberId)).data
        && get(/databases/$(database)/documents/members/$(memberId)).data.authUid
           == request.auth.uid
      )
      || (
        request.auth.token.email != null
        && get(/databases/$(database)/documents/members/$(memberId)).data.email
           == request.auth.token.email
      )
    );
}

function isActiveMember(memberId) {
  return get(/databases/$(database)/documents/members/$(memberId)).data.status
     == "active";
}

match /memberProfiles/{memberId} {
  // ê³µê° íìê°ì transaction ììì membersì ëìì ìµì´ ìì±
  allow create: if
    request.resource.data.keys().hasAll([
      "memberId", "memberNumber", "email", "phoneKey",
      "profileVersion", "basic", "additional", "special", "consumer",
      "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "memberId", "memberNumber", "email", "phoneKey",
      "profileVersion", "basic", "additional", "special", "consumer",
      "createdAt", "updatedAt"
    ])
    && request.resource.data.memberId == memberId
    && request.resource.data.profileVersion == 1
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && getAfter(/databases/$(database)/documents/members/$(memberId)).data.memberNumber
       == request.resource.data.memberNumber
    && getAfter(/databases/$(database)/documents/members/$(memberId)).data.email
       == request.resource.data.email
    && getAfter(/databases/$(database)/documents/members/$(memberId)).data.phoneKey
       == request.resource.data.phoneKey;

  allow read: if isAdmin() || ownsMember(memberId);

  allow update: if
    isAdmin()
    || (
      ownsMember(memberId)
      && request.resource.data.memberId == resource.data.memberId
      && request.resource.data.memberNumber == resource.data.memberNumber
      && request.resource.data.email
         == getAfter(/databases/$(database)/documents/members/$(memberId)).data.email
      && request.resource.data.phoneKey
         == getAfter(/databases/$(database)/documents/members/$(memberId)).data.phoneKey
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.updatedAt == request.time
    );

  allow delete: if isAdmin();
}

match /memberAddresses/{addressId} {
  allow create: if
    request.auth != null
    && request.resource.data.memberId is string
    && ownsMember(request.resource.data.memberId)
    && request.resource.data.keys().hasAll([
      "memberId", "label", "recipient", "phone", "postalCode",
      "address", "addressDetail", "isDefault", "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "memberId", "label", "recipient", "phone", "postalCode",
      "address", "addressDetail", "isDefault", "createdAt", "updatedAt"
    ])
    && request.resource.data.label is string
    && request.resource.data.label.size() >= 1
    && request.resource.data.label.size() <= 30
    && request.resource.data.recipient is string
    && request.resource.data.recipient.size() >= 1
    && request.resource.data.recipient.size() <= 50
    && request.resource.data.phone is string
    && request.resource.data.phone.size() >= 9
    && request.resource.data.phone.size() <= 30
    && request.resource.data.postalCode is string
    && request.resource.data.postalCode.size() <= 10
    && request.resource.data.address is string
    && request.resource.data.address.size() >= 1
    && request.resource.data.address.size() <= 200
    && request.resource.data.addressDetail is string
    && request.resource.data.addressDetail.size() <= 150
    && request.resource.data.isDefault is bool
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow read: if isAdmin() || ownsMember(resource.data.memberId);

  allow update: if
    isAdmin()
    || (
      ownsMember(resource.data.memberId)
      && request.resource.data.memberId == resource.data.memberId
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.updatedAt == request.time
    );

  allow delete: if isAdmin() || ownsMember(resource.data.memberId);
}

match /memberPhones/{phoneKey} {
  allow delete: if
    request.auth != null
    && resource.data.memberId is string
    && ownsMember(resource.data.memberId);
}

// 주의회원·일시정지·블랙리스트는 일반 탈퇴와 분리하여 관리자만 관리한다.
match /memberRestrictions/{memberId} {
  allow read, create, update, delete: if isAdmin();
}

// 블랙리스트 이메일 원문을 공개하지 않고 SHA-256 문서 키로 재가입을 차단한다.
match /memberEmailBlocks/{emailHash} {
  allow get: if true;
  allow list, create, update, delete: if isAdmin();
}

match /accountDeletionRequests/{memberId} {
  allow create: if
    ownsMember(memberId)
    && request.resource.data.keys().hasAll([
      "memberId", "memberNumber", "name", "email", "reason",
      "status", "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "memberId", "memberNumber", "name", "email", "reason",
      "status", "privacyDisposalStatus", "adminMemo", "reviewedBy",
      "reviewedAt", "createdAt", "updatedAt"
    ])
    && request.resource.data.memberId == memberId
    && request.resource.data.memberNumber
       == get(/databases/$(database)/documents/members/$(memberId)).data.memberNumber
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 1
    && request.resource.data.name.size() <= 50
    && request.resource.data.reason is string
    && request.resource.data.reason.size() <= 500
    && request.resource.data.status == "requested"
    && (
      !("privacyDisposalStatus" in request.resource.data)
      || request.resource.data.privacyDisposalStatus == "not_started"
    )
    && (!("adminMemo" in request.resource.data) || request.resource.data.adminMemo == "")
    && (!("reviewedBy" in request.resource.data) || request.resource.data.reviewedBy == "")
    && (!("reviewedAt" in request.resource.data) || request.resource.data.reviewedAt == null)
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow read: if isAdmin() || ownsMember(memberId);

  allow update: if
    isAdmin()
    || (
      ownsMember(memberId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name", "email", "reason", "status", "privacyDisposalStatus",
        "adminMemo", "reviewedBy", "reviewedAt", "updatedAt"
      ])
      && request.resource.data.memberId == resource.data.memberId
      && request.resource.data.memberNumber == resource.data.memberNumber
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 1
      && request.resource.data.name.size() <= 50
      && request.resource.data.reason is string
      && request.resource.data.reason.size() <= 500
      && request.resource.data.status == "requested"
      && request.resource.data.privacyDisposalStatus == "not_started"
      && request.resource.data.adminMemo == ""
      && request.resource.data.reviewedBy == ""
      && request.resource.data.reviewedAt == null
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.updatedAt == request.time
    );

  allow delete: if isAdmin();
}

match /accountChangeLogs/{logId} {
  allow create: if
    isAdmin()
    || (
      request.auth != null
      && request.auth.token.email_verified == true
      && request.resource.data.keys().hasAll([
        "memberId", "memberNumber", "memberName", "actorUid", "actorEmail",
        "actorType", "eventType", "changedFields", "before", "after",
        "description", "createdAt"
      ])
      && request.resource.data.keys().hasOnly([
        "memberId", "memberNumber", "memberName", "actorUid", "actorEmail",
        "actorType", "eventType", "changedFields", "before", "after",
        "description", "createdAt"
      ])
      && ownsMember(request.resource.data.memberId)
      && request.resource.data.actorUid == request.auth.uid
      && request.resource.data.actorEmail == request.auth.token.email
      && request.resource.data.actorType == "member"
      && request.resource.data.eventType in [
        "basic_profile_updated", "email_synced", "email_change_requested",
        "password_reset_requested", "deletion_requested"
      ]
      && request.resource.data.memberNumber is string
      && request.resource.data.memberNumber.size() <= 30
      && request.resource.data.memberName is string
      && request.resource.data.memberName.size() >= 1
      && request.resource.data.memberName.size() <= 50
      && request.resource.data.changedFields is list
      && request.resource.data.changedFields.size() >= 1
      && request.resource.data.changedFields.size() <= 10
      && request.resource.data.before is map
      && request.resource.data.after is map
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 500
      && request.resource.data.createdAt == request.time
    );

  allow read: if isAdmin();
  allow update: if false;
  allow delete: if isAdmin();
}

match /benefitApplications/{applicationId} {
  allow create: if request.auth != null
    && request.resource.data.keys().hasAll(["type","name","phone","region","message","memberId","memberEmail","offerId","offerTitle","receipt","status","source","createdAt","updatedAt"])
    && request.resource.data.keys().hasOnly(["type","name","phone","region","message","memberId","memberEmail","offerId","offerTitle","receipt","status","source","createdAt","updatedAt"])
    && ownsMember(request.resource.data.memberId)
    && request.resource.data.memberEmail == request.auth.token.email
    && request.resource.data.type is string && request.resource.data.type.size() >= 1 && request.resource.data.type.size() <= 100
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 50
    && request.resource.data.phone is string && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 30
    && request.resource.data.region is string && request.resource.data.region.size() >= 1 && request.resource.data.region.size() <= 100
    && request.resource.data.message is string && request.resource.data.message.size() <= 1000
    && request.resource.data.offerId is string && request.resource.data.offerId.size() >= 1 && request.resource.data.offerId.size() <= 100
    && request.resource.data.offerTitle is string && request.resource.data.offerTitle.size() >= 1 && request.resource.data.offerTitle.size() <= 200
    && request.resource.data.receipt is string && request.resource.data.receipt.matches('^NCC-[0-9]{6}-[0-9]{5}$')
    && request.resource.data.status == "new" && request.resource.data.source == "website"
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
  allow read: if isAdmin() || (request.auth != null && ownsMember(resource.data.memberId));
}

// 혜택 처리상태와 모집 시작 안내는 관리자만 만들고 해당 회원만 읽는다.
match /memberNotifications/{notificationId} {
  allow create: if isAdmin()
    && request.resource.data.keys().hasAll([
      "memberId", "applicationId", "offerId", "offerTitle", "applicationType",
      "status", "title", "message", "href", "read", "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "memberId", "applicationId", "offerId", "offerTitle", "applicationType",
      "status", "title", "message", "href", "read", "createdAt", "updatedAt"
    ])
    && request.resource.data.memberId is string
    && request.resource.data.memberId.size() >= 1
    && request.resource.data.applicationId is string
    && request.resource.data.applicationId.size() >= 1
    && request.resource.data.offerId is string
    && request.resource.data.offerId.size() <= 100
    && request.resource.data.offerTitle is string
    && request.resource.data.offerTitle.size() >= 1
    && request.resource.data.offerTitle.size() <= 200
    && request.resource.data.applicationType is string
    && request.resource.data.applicationType.size() >= 1
    && request.resource.data.applicationType.size() <= 100
    && request.resource.data.status in ["checking", "contacted", "approved", "hold"]
    && request.resource.data.title is string
    && request.resource.data.title.size() >= 1
    && request.resource.data.title.size() <= 100
    && request.resource.data.message is string
    && request.resource.data.message.size() >= 1
    && request.resource.data.message.size() <= 500
    && request.resource.data.href is string
    && request.resource.data.href.size() <= 300
    && request.resource.data.read == false
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow read: if isAdmin() || (request.auth != null && ownsMember(resource.data.memberId));

  allow update: if isAdmin()
    && request.resource.data.memberId == resource.data.memberId
    && request.resource.data.applicationId == resource.data.applicationId
    && request.resource.data.offerId == resource.data.offerId
    && request.resource.data.offerTitle == resource.data.offerTitle
    && request.resource.data.applicationType == resource.data.applicationType
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.read == resource.data.read
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status", "title", "message", "href", "updatedAt"
    ])
    && request.resource.data.status in ["checking", "contacted", "approved", "hold"]
    && request.resource.data.title is string
    && request.resource.data.title.size() >= 1
    && request.resource.data.title.size() <= 100
    && request.resource.data.message is string
    && request.resource.data.message.size() >= 1
    && request.resource.data.message.size() <= 500
    && request.resource.data.href is string
    && request.resource.data.href.size() <= 300
    && request.resource.data.updatedAt == request.time;

  allow delete: if isAdmin();
}

match /groupBuyOrders/{orderId} {
  allow create: if request.auth != null
    && request.resource.data.keys().hasAll(["productId","productTitle","memberId","memberEmail","name","phone","phoneKey","quantity","region","address","message","receipt","totalPrice","paymentGuide","carrier","trackingNumber","adminMemo","status","source","snapshotVersion","productSnapshot","deliverySnapshot","applicationSnapshot","createdAt","updatedAt"])
    && request.resource.data.keys().hasOnly(["productId","productTitle","memberId","memberEmail","name","phone","phoneKey","quantity","region","address","message","receipt","totalPrice","paymentGuide","carrier","trackingNumber","adminMemo","status","source","snapshotVersion","productSnapshot","deliverySnapshot","applicationSnapshot","createdAt","updatedAt"])
    && ownsMember(request.resource.data.memberId)
    && isActiveMember(request.resource.data.memberId)
    && request.resource.data.memberEmail == request.auth.token.email
    && request.resource.data.productId is string && request.resource.data.productId.size() >= 1 && request.resource.data.productId.size() <= 100
    && request.resource.data.productTitle is string && request.resource.data.productTitle.size() >= 1 && request.resource.data.productTitle.size() <= 120
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 50
    && request.resource.data.phone is string && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 30
    && request.resource.data.phoneKey is string && request.resource.data.phoneKey.matches('^[0-9]{9,11}$')
    && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 20
    && request.resource.data.region is string && request.resource.data.region.size() >= 1 && request.resource.data.region.size() <= 100
    && request.resource.data.address is string && request.resource.data.address.size() >= 1 && request.resource.data.address.size() <= 300
    && request.resource.data.message is string && request.resource.data.message.size() <= 500
    && request.resource.data.receipt is string && request.resource.data.receipt.matches('^NCC-G-[0-9]{6}-[0-9]{5}$')
    && request.resource.data.totalPrice is int && request.resource.data.totalPrice >= 0
    && request.resource.data.snapshotVersion == 1
    && request.resource.data.productSnapshot is map
    && request.resource.data.productSnapshot.keys().hasAll(["title","image","description","option","unitPrice","regularPrice","shipping","supplier"])
    && request.resource.data.productSnapshot.keys().hasOnly(["title","image","description","option","unitPrice","regularPrice","shipping","supplier"])
    && request.resource.data.productSnapshot.title is string && request.resource.data.productSnapshot.title.size() >= 1 && request.resource.data.productSnapshot.title.size() <= 120
    && request.resource.data.productSnapshot.image is string && request.resource.data.productSnapshot.image.size() <= 500
    && request.resource.data.productSnapshot.description is string && request.resource.data.productSnapshot.description.size() <= 2000
    && request.resource.data.productSnapshot.option is string && request.resource.data.productSnapshot.option.size() <= 300
    && request.resource.data.productSnapshot.unitPrice is int && request.resource.data.productSnapshot.unitPrice >= 0
    && request.resource.data.productSnapshot.regularPrice is int && request.resource.data.productSnapshot.regularPrice >= 0
    && request.resource.data.productSnapshot.shipping is string && request.resource.data.productSnapshot.shipping.size() <= 500
    && request.resource.data.productSnapshot.supplier is string && request.resource.data.productSnapshot.supplier.size() <= 200
    && request.resource.data.deliverySnapshot is map
    && request.resource.data.deliverySnapshot.keys().hasAll(["recipient","phone","postalCode","address","addressDetail","request"])
    && request.resource.data.deliverySnapshot.keys().hasOnly(["recipient","phone","postalCode","address","addressDetail","request"])
    && request.resource.data.deliverySnapshot.recipient is string && request.resource.data.deliverySnapshot.recipient.size() >= 1 && request.resource.data.deliverySnapshot.recipient.size() <= 50
    && request.resource.data.deliverySnapshot.phone is string && request.resource.data.deliverySnapshot.phone.size() >= 9 && request.resource.data.deliverySnapshot.phone.size() <= 30
    && request.resource.data.deliverySnapshot.postalCode is string && request.resource.data.deliverySnapshot.postalCode.size() <= 10
    && request.resource.data.deliverySnapshot.address is string && request.resource.data.deliverySnapshot.address.size() >= 1 && request.resource.data.deliverySnapshot.address.size() <= 200
    && request.resource.data.deliverySnapshot.addressDetail is string && request.resource.data.deliverySnapshot.addressDetail.size() <= 150
    && request.resource.data.deliverySnapshot.request is string && request.resource.data.deliverySnapshot.request.size() <= 500
    && request.resource.data.applicationSnapshot is map
    && request.resource.data.applicationSnapshot.keys().hasAll(["quantity","unitPrice","totalPrice","region"])
    && request.resource.data.applicationSnapshot.keys().hasOnly(["quantity","unitPrice","totalPrice","region"])
    && request.resource.data.applicationSnapshot.quantity == request.resource.data.quantity
    && request.resource.data.applicationSnapshot.unitPrice == request.resource.data.productSnapshot.unitPrice
    && request.resource.data.applicationSnapshot.totalPrice == request.resource.data.totalPrice
    && request.resource.data.applicationSnapshot.region == request.resource.data.region
    && request.resource.data.paymentGuide == ""
    && request.resource.data.carrier == ""
    && request.resource.data.trackingNumber == ""
    && request.resource.data.adminMemo == ""
    && request.resource.data.status == "new" && request.resource.data.source == "website"
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
  allow read: if isAdmin() || (request.auth != null && ownsMember(resource.data.memberId));
}

function validNewLike(commentId) {
  let likeId = commentId + "_" + request.auth.uid;
  return !exists(/databases/$(database)/documents/expectationLikes/$(likeId))
    && existsAfter(/databases/$(database)/documents/expectationLikes/$(likeId));
}

match /expectationComments/{commentId} {
  allow read: if isAdmin() || resource.data.status == "visible";

  allow create: if request.auth != null
    && request.auth.token.email_verified == true
    && request.resource.data.keys().hasOnly([
      "targetType",
      "targetId",
      "targetKey",
      "memberId",
      "authorEmail",
      "authorMasked",
      "content",
      "likeCount",
      "status",
      "createdAt",
      "updatedAt"
    ])
    && ownsMember(request.resource.data.memberId)
    && request.resource.data.authorEmail == request.auth.token.email
    && request.resource.data.targetType in ["benefit", "groupbuy"]
    && request.resource.data.targetId is string
    && request.resource.data.targetId.size() >= 1
    && request.resource.data.targetId.size() <= 100
    && request.resource.data.targetKey is string
    && request.resource.data.targetKey.size() <= 220
    && request.resource.data.authorMasked is string
    && request.resource.data.authorMasked.size() <= 20
    && request.resource.data.content is string
    && request.resource.data.content.size() >= 2
    && request.resource.data.content.size() <= 180
    && request.resource.data.likeCount == 0
    && request.resource.data.status == "visible"
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow update: if isAdmin()
    || (
      request.auth != null
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "likeCount",
          "updatedAt"
        ])
      && request.resource.data.likeCount
        == resource.data.likeCount + 1
      && request.resource.data.updatedAt == request.time
      && validNewLike(commentId)
    );

  allow delete: if isAdmin();
}

match /expectationLikes/{likeId} {
  allow read: if request.auth != null;
  allow create: if request.auth != null
    && likeId == request.resource.data.commentId + "_" + request.auth.uid
    && !exists(/databases/$(database)/documents/expectationLikes/$(likeId))
    && request.resource.data.keys().hasOnly(["commentId","userId","createdAt"])
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.createdAt == request.time;
  allow update: if false;
  allow delete: if isAdmin();
}

match /reviews/{reviewId} {
  allow read: if isAdmin() || resource.data.status == "visible";
  allow create: if request.auth != null && request.auth.token.email_verified == true
    && request.resource.data.keys().hasOnly(["targetType","targetId","targetKey","verificationCollection","verificationId","memberId","authorEmail","authorMasked","rating","title","content","verified","status","createdAt","updatedAt"])
    && ownsMember(request.resource.data.memberId)
    && request.resource.data.authorEmail == request.auth.token.email
    && request.resource.data.targetType in ["benefit","groupbuy"]
    && reviewId == request.resource.data.targetType + "_" + request.resource.data.verificationId
    && request.resource.data.targetId is string && request.resource.data.targetId.size() >= 1 && request.resource.data.targetId.size() <= 100
    && request.resource.data.targetKey is string && request.resource.data.targetKey.size() <= 220
    && request.resource.data.verificationId is string && request.resource.data.verificationId.size() >= 1
    && request.resource.data.authorMasked is string && request.resource.data.authorMasked.size() <= 20
    && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
    && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
    && request.resource.data.content is string && request.resource.data.content.size() >= 10 && request.resource.data.content.size() <= 1500
    && request.resource.data.verified == true && request.resource.data.status == "visible"
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
    && ((request.resource.data.targetType == "groupbuy"
      && request.resource.data.verificationCollection == "groupBuyOrders"
      && get(/databases/$(database)/documents/groupBuyOrders/$(request.resource.data.verificationId)).data.memberId == request.resource.data.memberId
      && get(/databases/$(database)/documents/groupBuyOrders/$(request.resource.data.verificationId)).data.productId == request.resource.data.targetId
      && get(/databases/$(database)/documents/groupBuyOrders/$(request.resource.data.verificationId)).data.status == "completed")
    || (request.resource.data.targetType == "benefit"
      && request.resource.data.verificationCollection == "benefitApplications"
      && get(/databases/$(database)/documents/benefitApplications/$(request.resource.data.verificationId)).data.memberId == request.resource.data.memberId
      && get(/databases/$(database)/documents/benefitApplications/$(request.resource.data.verificationId)).data.offerId == request.resource.data.targetId
      && get(/databases/$(database)/documents/benefitApplications/$(request.resource.data.verificationId)).data.status == "approved"));
  allow update, delete: if isAdmin();
}

match /reviewReports/{reportId} {
  allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(["contentType","targetDocId","reporterEmail","reason","status","createdAt","updatedAt"])
    && request.resource.data.contentType in ["comment","review"]
    && request.resource.data.targetDocId is string && request.resource.data.targetDocId.size() >= 1
    && request.resource.data.reporterEmail == request.auth.token.email
    && request.resource.data.reason is string && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 300
    && request.resource.data.status == "new"
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
  allow read, update, delete: if isAdmin();
  }
  match /partnerSubmissions/{submissionId} {
  allow create: if request.auth != null
    && request.auth.token.email_verified == true
    && request.resource.data.keys().hasAll([
      "memberId", "partnerId", "partnerName", "submissionType", "title",
      "benefitClass", "category", "region", "summary", "quantity",
      "regularPrice", "memberPrice", "deliveryFee", "startDate", "endDate",
      "reviewRequirement", "status", "adminMemo", "createdAt", "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "memberId", "partnerId", "partnerName", "submissionType", "title",
      "benefitClass", "category", "region", "summary", "quantity",
      "regularPrice", "memberPrice", "deliveryFee", "startDate", "endDate",
      "reviewRequirement", "status", "adminMemo", "createdAt", "updatedAt"
    ])
    && request.resource.data.memberId is string
    && ownsMember(request.resource.data.memberId)
    && isActiveMember(request.resource.data.memberId)
    && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.memberType in ["partner", "corporate", "soleProprietor"]
    && request.resource.data.partnerId is string
    && request.resource.data.partnerId.size() <= 100
    && request.resource.data.partnerName is string
    && request.resource.data.partnerName.size() >= 1
    && request.resource.data.partnerName.size() <= 100
    && request.resource.data.submissionType in ["benefit", "experience", "groupbuy"]
    && request.resource.data.title is string
    && request.resource.data.title.size() >= 1
    && request.resource.data.title.size() <= 120
    && request.resource.data.benefitClass in ["FIRST", "PREMIUM", "DAILY"]
    && request.resource.data.category is string
    && request.resource.data.category.size() >= 1
    && request.resource.data.category.size() <= 80
    && request.resource.data.region is string
    && request.resource.data.region.size() >= 1
    && request.resource.data.region.size() <= 100
    && request.resource.data.summary is string
    && request.resource.data.summary.size() >= 1
    && request.resource.data.summary.size() <= 1000
    && request.resource.data.quantity is int
    && request.resource.data.quantity >= 0
    && request.resource.data.regularPrice is int
    && request.resource.data.regularPrice >= 0
    && request.resource.data.memberPrice is int
    && request.resource.data.memberPrice >= 0
    && request.resource.data.deliveryFee is int
    && request.resource.data.deliveryFee >= 0
    && request.resource.data.startDate is string
    && request.resource.data.startDate.size() <= 20
    && request.resource.data.endDate is string
    && request.resource.data.endDate.size() <= 20
    && request.resource.data.reviewRequirement is string
    && request.resource.data.reviewRequirement.size() <= 300
    && request.resource.data.status == "pending"
    && request.resource.data.adminMemo == ""
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow read: if isAdmin()
    || (request.auth != null && ownsMember(resource.data.memberId) && isActiveMember(resource.data.memberId));

  allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status", "adminMemo", "updatedAt"
    ])
    && request.resource.data.status in [
      "pending", "reviewing", "approved", "rejected", "published"
    ]
    && request.resource.data.adminMemo is string
    && request.resource.data.adminMemo.size() <= 1000
    && request.resource.data.updatedAt == request.time;

  allow delete: if isAdmin();
}

match /centerActivities/{activityId} {
  allow create: if request.auth != null
    && request.auth.token.email_verified == true
    && request.resource.data.keys().hasAll([
