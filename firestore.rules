  allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status", "adminMemo", "updatedAt"
    ])
    && request.resource.data.status in [
      "pending", "reviewing", "approved", "rejected", "published"
    ]
    && request.resource.data.adminMemo is string
    && request.resource.data.adminMemo.size() <= 1000
    && request.resource.data.updatedAt == request.time;

  allow delete: if isAdmin();
}
    // REF-NCC-CERTIFICATE-VERIFICATION-PRODUCTION-01
    // Public records contain only certificate display metadata.
    match /certificates/{certificateId} {
      allow get: if isAdmin() || resource.data.public == true;
      allow list: if isAdmin();

      allow create: if
        isAdmin()
        && request.resource.data.keys().hasAll([
          "certificateNumber", "certificateType", "title", "recipientName",
          "representativeName", "selectionNumber", "category", "region", "evaluationGroup",
          "issuedAt", "validUntil", "issuer", "imageUrl", "status", "public",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "certificateNumber", "certificateType", "title", "recipientName",
          "representativeName", "selectionNumber", "category", "region", "evaluationGroup",
          "issuedAt", "validUntil", "issuer", "imageUrl", "status", "public",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.certificateNumber == certificateId
        && request.resource.data.certificateNumber is string
        && request.resource.data.certificateNumber.matches('^NCC-[A-Z0-9]+(-[A-Z0-9]+){2,6}$')
        && request.resource.data.certificateType in [
          "business_certificate", "store_certificate", "excellent_company", "excellent_product_service",
          "official_partner", "center_appointment"
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() >= 1
        && request.resource.data.recipientName.size() <= 120
        && request.resource.data.representativeName is string
        && request.resource.data.representativeName.size() <= 60
        && request.resource.data.selectionNumber is string
        && request.resource.data.selectionNumber.size() <= 60
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 120
        && request.resource.data.evaluationGroup is string
        && request.resource.data.evaluationGroup.size() <= 120
        && request.resource.data.issuedAt is string
        && request.resource.data.issuedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.validUntil is string
        && (
          request.resource.data.validUntil == ""
          || request.resource.data.validUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        && request.resource.data.issuer is string
        && request.resource.data.issuer.size() >= 1
        && request.resource.data.issuer.size() <= 120
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && request.resource.data.status in ["active", "revoked", "expired", "sample"]
        && request.resource.data.public is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if
        isAdmin()
        && request.resource.data.keys().hasAll([
          "certificateNumber", "certificateType", "title", "recipientName",
          "representativeName", "selectionNumber", "category", "region", "evaluationGroup",
          "issuedAt", "validUntil", "issuer", "imageUrl", "status", "public",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "certificateNumber", "certificateType", "title", "recipientName",
          "representativeName", "selectionNumber", "category", "region", "evaluationGroup",
          "issuedAt", "validUntil", "issuer", "imageUrl", "status", "public",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.certificateNumber == certificateId
        && request.resource.data.certificateNumber == resource.data.certificateNumber
        && request.resource.data.certificateType in [
          "business_certificate", "store_certificate", "excellent_company", "excellent_product_service",
          "official_partner", "center_appointment"
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() >= 1
        && request.resource.data.recipientName.size() <= 120
        && request.resource.data.representativeName is string
        && request.resource.data.representativeName.size() <= 60
        && request.resource.data.selectionNumber is string
        && request.resource.data.selectionNumber.size() <= 60
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 120
        && request.resource.data.evaluationGroup is string
        && request.resource.data.evaluationGroup.size() <= 120
        && request.resource.data.issuedAt is string
        && request.resource.data.issuedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.validUntil is string
        && (
          request.resource.data.validUntil == ""
          || request.resource.data.validUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        && request.resource.data.issuer is string
        && request.resource.data.issuer.size() >= 1
        && request.resource.data.issuer.size() <= 120
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && request.resource.data.status in ["active", "revoked", "expired", "sample"]
        && request.resource.data.public is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /certificateLogs/{logId} {
      allow create: if
        isAdmin()
        && request.resource.data.keys().hasAll([
          "certificateNumber", "eventType", "status", "public",
          "actorEmail", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "certificateNumber", "eventType", "status", "public",
          "actorEmail", "createdAt"
        ])
        && request.resource.data.certificateNumber is string
        && request.resource.data.eventType in ["created", "updated"]
        && request.resource.data.status in ["active", "revoked", "expired", "sample"]
        && request.resource.data.public is bool
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }


    match /memberDataExportLogs/{logId} {
      allow create: if
        isAdmin()
        && request.resource.data.keys().hasAll([
          "action", "format", "exportedCount", "filterSummary",
          "actorUid", "actorEmail", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "action", "format", "exportedCount", "filterSummary",
          "actorUid", "actorEmail", "createdAt"
        ])
        && request.resource.data.action == "member_export"
        && request.resource.data.format in ["csv", "excel"]
        && request.resource.data.exportedCount is int
        && request.resource.data.exportedCount >= 0
        && request.resource.data.filterSummary is map
        && request.resource.data.filterSummary.keys().hasAll([
          "status", "memberType", "managementGrade", "hasKeyword"
        ])
        && request.resource.data.filterSummary.keys().hasOnly([
          "status", "memberType", "managementGrade", "hasKeyword"
        ])
        && request.resource.data.filterSummary.status is string
        && request.resource.data.filterSummary.memberType is string
        && request.resource.data.filterSummary.managementGrade is string
        && request.resource.data.filterSummary.hasKeyword is bool
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Public center directory contains official administrative names/codes only.
    // Member data and manager contact information must never be stored here.
    match /centerDirectory/{centerCode} {
      allow read: if true;
      allow create, update: if
        isAdmin()
        && request.resource.data.keys().hasAll([
          "centerCode", "officialAdminCode", "centerName", "level", "status"
        ])
        && request.resource.data.keys().hasOnly([
          "centerCode", "officialAdminCode", "provinceName", "municipalityName",
          "localName", "fullName", "centerName", "level", "status", "effectiveFrom"
        ])
        && request.resource.data.centerCode == centerCode
        && request.resource.data.centerCode.matches('^NCC-[PML]-[0-9]{10}$')
        && request.resource.data.officialAdminCode.matches('^[0-9]{10}$')
        && request.resource.data.level in ["province", "municipality", "local"]
        && request.resource.data.status in ["reserved", "active", "inactive"];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
